<!DOCTYPE html>
<%
  display_mode = current_reader&.effective_display_mode || Bible270::Reader::DEFAULT_DISPLAY_MODE
  color_scheme = case display_mode
                 when "light", "sage", "mist" then "only light"
                 when "system" then "light dark"
                 else "dark"
                 end
%>
<html lang="en" data-b270-display-mode="<%= display_mode %>">
<head>
  <meta charset="utf-8">
  <meta id="b270-color-scheme" name="color-scheme" content="<%= color_scheme %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : Bible270.config.app_name %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag if respond_to?(:csp_meta_tag) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <%= b270_favicon_tag %>
  <%= render "bible270/shared/styles" %>
  <%= yield :head %>
</head>
<body class="b270" data-display-mode="<%= display_mode %>">
  <%= render "bible270/shared/theme_scenery" %>
  <div class="b270-wrap">
    <%= render "bible270/shared/header" %>
    <% if flash[:alert] %><div class="b270-flash alert"><%= flash[:alert] %></div><% end %>
    <% if flash[:notice] %><div class="b270-flash notice"><%= flash[:notice] %></div><% end %>
    <%= yield %>
    <%# Pages with their own day grid opt out with content_for :hide_day_index %>
    <%= render 'bible270/shared/day_index', expanded: content_for?(:expand_day_index) unless content_for?(:hide_day_index) %>
    <%= b270_footer %>
  </div>
  <%= render "bible270/shared/avatar_ui" %>
  <%= render "bible270/shared/theme_ui" %>
  <%= render "bible270/shared/scripture_popups" %>
  <%= render "bible270/shared/video_embeds" %>
</body>
</html>
