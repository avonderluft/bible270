<% content_for :title, "#{@reader.display_name} — Admin" %>
<% content_for :hide_day_index, true %><%# this page has its own grid %>
<p class="b270-eyebrow"><%= link_to 'Admin', admin_path %></p>
<h1><%= @reader.display_name %></h1>
<p class="lede">
  <%= @reader.email.present? ? mail_to(@reader.email) : @reader.provider %> ·
  <%= @days_completed %> of <%= Bible270::Plan::DAYS %> days ·
  <%= @reader.completion_percent %>%
  <% if @reader.today_day %>· day <%= @reader.today_day %> today
  <% elsif @reader.not_started_yet? %>· starts <%= @reader.effective_start_date.strftime('%b %-d, %Y') %>
  <% elsif @reader.past_end_date? %>· finished <%= @reader.plan_end_date.strftime('%b %-d, %Y') %><% end %>
</p>


<div class="b270-panel">
  <h2 class="b270-subhead">Name and picture</h2>
  <%= form_with url: admin_reader_profile_path(@reader), method: :patch, class: "b270-emailform",
                html: { multipart: true } do %>
    <div class="b270-avatarrow">
      <%= b270_avatar(@reader, size: 72, loading: 'eager') %>
      <% if Bible270::Reader.avatar_uploads? %>
        <div class="b270-avatarcontrols" style="flex:1;min-width:0">
          <label class="b270-field">
            <span>Picture</span>
            <%= file_field_tag :avatar, accept: Bible270::Avatars.content_types.join(',') %>
            <span class="b270-hint b270-avatar-hint" style="margin:0">
              PNG/JPEG/GIF/WebP · max <%= Bible270::Avatars.human_size(Bible270::Avatars.max_bytes) %>, <%= Bible270::AvatarOptimizer::MAX_PIXELS / 1_000_000 %>MP.
              Center-cropped square; animations use first frame.
            </span>
          </label>
          <% if @reader.avatar_uploaded? %>
            <%= button_tag "Remove picture", type: "submit", class: "b270-linkbtn",
                  form: "b270-remove-picture" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="b270-name-fields">
      <label class="b270-field">
        <span>First name</span>
        <%= text_field_tag :first_name, @reader.suggested_names[:first_name], size: 16 %>
      </label>
      <label class="b270-field">
        <span>Last name</span>
        <%= text_field_tag :last_name, @reader.suggested_names[:last_name], size: 16 %>
      </label>
    </div>
    <%= submit_tag 'Save', class: 'b270-btn' %>
  <% end %>

  <% if @reader.avatar_uploaded? %>
    <%# Keep picture removal separate from unsaved name and upload changes. %>
    <%= form_with url: admin_reader_avatar_path(@reader), method: :delete,
          html: { id: "b270-remove-picture", hidden: true },
          data: { turbo_confirm: "Remove #{@reader.display_name}'s picture?" } do %>
    <% end %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Which translation they read</h2>
  <p class="b270-hint" style="margin-top:0">
    Reading links open in this translation.
    <% if @reader.bible_version.blank? %>
      They have expressed no preference, so they follow the site default
      (<%= Bible270.config.bible_version %>).
    <% end %>
  </p>

  <%= form_with url: admin_reader_version_path(@reader), method: :patch, class: "b270-form" do %>
    <div class="row">
      <span class="b270-select-wrap b270-select-wrap--full">
        <%= select_tag :bible_version,
              options_for_select([["Site default (#{Bible270.config.bible_version})", ""]] +
                                 Bible270::Translations.options,
                                 @reader.bible_version.to_s),
              class: "b270-select", aria: { label: "Bible translation" } %>
      </span>
    </div>
    <%= render "bible270/shared/passage_source", reader: @reader %>
    <%= submit_tag "Save", class: "b270-btn" %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead" id="b270-theme-heading">Theme</h2>
  <% if Bible270::Reader.display_mode_column? %>
    <%= form_with url: admin_reader_theme_path(@reader), method: :patch, class: "b270-emailform" do %>
      <span class="b270-select-wrap b270-select-wrap--full">
        <%= select_tag :display_mode,
              options_for_select(Bible270::Reader::DISPLAY_OPTIONS, @reader.effective_display_mode),
              class: "b270-select", aria: { labelledby: "b270-theme-heading", describedby: "b270-theme-hint b270-theme-status" },
              data: { b270_theme_url: admin_reader_theme_path(@reader), b270_theme_apply: @reader == current_reader,
                      b270_saved_theme: @reader.effective_display_mode } %>
      </span>
      <p id="b270-theme-hint" class="b270-hint b270-theme-hint" style="margin:0">
        System: Papyrus (light), Cedar (dark).
      </p>
      <p id="b270-theme-status" class="b270-hint" role="status" aria-live="polite" style="margin:0"></p>
      <%= submit_tag "Save", class: "b270-btn", data: { b270_theme_fallback: true } %>
    <% end %>
  <% else %>
    <p class="b270-flash alert" style="margin:0">
      Run the pending Bible270 database migration before changing the theme.
    </p>
  <% end %>
</div>


<div class="b270-panel">
  <h2 class="b270-subhead">Email notifications</h2>
  <% unless Bible270.config.mention_notifications %>
    <p class="b270-hint">Reflection emails are disabled for this installation.</p>
  <% else %>
    <% unless @comment_notifications_available %>
      <p class="b270-flash alert" style="margin:0">
        Run the pending Bible270 database migration before changing reflection emails.
      </p>
    <% else %>
      <% if @reader.email.blank? %>
        <p class="b270-hint">This reader does not currently have an email address.</p>
      <% end %>
      <%= form_with url: admin_reader_notifications_path(@reader), method: :patch,
                    class: "b270-emailform" do %>
        <%= render "bible270/shared/comment_notification_choices",
              level: @reader.comment_notification_level,
              personal_label: "Only replies to their reflections and mentions of them" %>
        <%= submit_tag 'Save', class: 'b270-btn' %>
      <% end %>
    <% end %>
  <% end %>
</div>

<% unless @reader.alumni? %>
<div class="b270-panel">
  <h2 class="b270-subhead">Where they are in the plan</h2>
  <div class="b270-admin-position-controls">
    <%= form_with url: admin_reader_start_path(@reader), method: :patch, class: "b270-startform" do %>
      <%= hidden_field_tag :participation_id, @reader.participation.id %>
      <label class="b270-field">
        <span>Day:</span>
        <%= number_field_tag :day, @reader.calendar_day || 1, min: 1, max: Bible270::Plan::DAYS %>
      </label>
      <%= submit_tag 'Move', class: 'b270-btn' %>
    <% end %>
    <%= form_with url: admin_reader_start_path(@reader), method: :patch, class: "b270-startform" do %>
      <%= hidden_field_tag :participation_id, @reader.participation.id %>
      <label class="b270-field">
        <span>Start date:</span>
        <%= date_field_tag :start_date, @reader.started_on %>
      </label>
      <%= submit_tag 'Set date', class: 'b270-btn' %>
    <% end %>
  </div>
  <p class="b270-hint">Moving someone re-maps the calendar only. Their check-offs are keyed to day
     numbers and are not touched.</p>
</div>
<% end %>

<div class="b270-panel b270-admin-control" id="b270-role">
  <h2 class="b270-subhead">Role: <%= Bible270.config.site_admin?(@reader) ? 'Site-admin' : (Bible270.config.admin?(@reader) ? 'Admin' : 'Reader') %></h2>
  <% unless Bible270.config.site_admin?(@reader) %>
    <% if b270_site_admin? && @reader != current_reader %>
      <%= button_to(Bible270.config.admin?(@reader) ? 'Remove admin access' : 'Grant admin access',
            admin_reader_role_path(@reader), method: :patch,
            params: { role: Bible270.config.admin?(@reader) ? 'reader' : 'admin' }, class: 'b270-btn',
            form: { data: { b270_admin_confirm: 'Change this reader’s admin access? Membership and progress will not change.' } }) %>
    <% end %>
  <% end %>
</div>

<div class="b270-panel b270-admin-control" id="b270-participation">
  <h2 class="b270-subhead">Status: <%= @reader.alumni? ? 'Alumni' : 'Active' %></h2>
  <% if @reader.alumni? %>
    <%= button_to 'Make active', admin_reader_participation_path(@reader), method: :patch,
          params: { status: 'active', expected_run_id: @current_run.id }, class: 'b270-btn',
          form: { data: { b270_admin_confirm: 'Reactivate this reader in the current run? Same-run progress is preserved; joining a different run starts fresh progress and clears their personal start date. Past history is preserved.' } } %>
  <% else %>
    <%= button_to 'Make alumni', admin_reader_participation_path(@reader), method: :patch,
          params: { status: 'alumni', expected_run_id: @current_run.id }, class: 'b270-btn',
          form: { data: { b270_admin_confirm: 'Mark this reader as alumni? Their calendar and progress will become read-only. History, reflections and admin privileges are preserved.' } } %>
  <% end %>
</div>

<div class="b270-panel b270-admin-control" id="b270-completion-animation">
  <h2 class="b270-subhead" id="b270-completion-animation-heading">Completion animation</h2>
  <% unless @completion_dove_preference_available %>
    <p class="b270-flash alert" style="margin:0">
      Run the pending Bible270 database migration before changing the completion animation.
    </p>
  <% else %>
    <%= form_with url: admin_reader_completion_animation_path(@reader), method: :patch,
                  class: "b270-admin-inline-form", html: { aria: { labelledby: "b270-completion-animation-heading" } } do %>
      <%= hidden_field_tag :completion_dove_disabled, @reader.completion_dove_disabled? ? '0' : '1' %>
      <%= submit_tag @reader.completion_dove_disabled? ? 'Enable' : 'Disable', class: 'b270-btn' %>
    <% end %>
  <% end %>
</div>


<div class="b270-panel">
  <%= render "bible270/shared/interaction_status" %>
  <%= render "bible270/shared/reflections", comments: @comments, moderate: true, editable: true, actions: true %>
</div>


<div class="b270-panel">
  <h2 class="b270-subhead">Completions</h2>
  <% unless @reader.alumni? %>
  <%= form_with url: admin_reader_through_path(@reader), method: :patch, class: "b270-startform" do %>
    <%= hidden_field_tag :participation_id, @reader.participation.id %>
    <label class="b270-field">
      <span>Mark complete through day (0 clears everything)</span>
      <%= number_field_tag :day, @days_completed, min: 0, max: Bible270::Plan::DAYS %>
    </label>
    <%= submit_tag 'Apply', class: 'b270-btn' %>
  <% end %>
  <p class="b270-hint">This also clears anything after that day, so it sets their progress exactly.</p>
  <% end %>

  <div class="b270-grid" style="margin-top:16px">
    <% (1..Bible270::Plan::DAYS).each do |d| %>
      <% if @reader.alumni? %>
        <%= content_tag :span, d, class: b270_day_cell_classes(d, reader: @reader), title: b270_day_readings(d), id: "day-#{d}" %>
      <% else %>
        <%= button_to d, admin_reader_day_path(@reader, d), method: :post,
              params: { participation_id: @reader.participation.id }, class: b270_day_cell_classes(d, reader: @reader),
              title: b270_day_readings(d),
              form: { style: 'display:contents', id: "day-#{d}" } %>
      <% end %>
    <% end %>
  </div>
  <p class="b270-hint"><%= @reader.alumni? ? 'Archived completions are read-only.' : 'Click a day to toggle it complete.' %></p>
</div>

<% if @past_participations.any? %>
  <div class="b270-panel" id="b270-run-history">
    <h2 class="b270-subhead">Past runs / history</h2>
    <p class="b270-hint">Frozen calendar dates and completed days are read-only.</p>
    <div class="b270-run-history-scroll" role="region" aria-label="Past runs" tabindex="0">
    <table class="b270-run-history-table">
      <thead><tr><th scope="col">Run</th><th>Start date</th><th>End date</th><th>Archived on</th><th>Days completed</th></tr></thead>
      <tbody>
        <% @past_participations.each do |participation| %>
          <tr>
            <td>Run <%= participation.plan_run.id %><% if participation.plan_run.reverted_at %> (reverted)<% end %></td>
            <td><%= participation.frozen_start_date ? participation.frozen_start_date.strftime('%b %-d, %Y') : 'Undated' %></td>
            <td><%= participation.frozen_start_date ? Bible270::Plan.end_date_for(participation.frozen_start_date).strftime('%b %-d, %Y') : 'Undated' %></td>
            <td><%= participation.archived_on ? participation.archived_on.strftime('%b %-d, %Y') : '—' %></td>
            <td><%= @history_completed_days[participation.id] %>/<%= Bible270::Plan::DAYS %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% end %>

<div class="b270-panel">
  <h2 class="b270-subhead">Remove</h2>
  <% if Bible270.config.site_admin?(@reader) %>
    <p class="b270-hint">Configured site-admins cannot be removed here. Their privileges are controlled by configuration.</p>
  <% elsif Bible270.config.admin?(@reader) && !b270_site_admin? %>
    <p class="b270-hint">Only a site-admin may remove an admin.</p>
  <% else %>
    <p class="b270-hint" style="margin-top:0">Deletes the reader together with every check-off and
       reflection from all their runs. This cannot be undone.</p>
    <%= button_to "Remove #{@reader.display_name}", admin_reader_path(@reader), method: :delete,
          class: 'b270-btn', form: { data: { b270_remove_reader: "Are you sure you want to remove #{@reader.display_name} from the plan? All their check-offs and reflections will be permanently deleted. This cannot be undone." } } %>
  <% end %>
</div>

<p style="margin-top:18px"><%= link_to '← All readers', admin_path %></p>
<%= render "bible270/shared/interaction_ui" %>
<%= render 'bible270/shared/admin_confirmations' %>
<script nonce="<%= content_security_policy_nonce %>" data-b270-reader-removal>
  (() => {
    if (window.Bible270ReaderRemoval) return;
    window.Bible270ReaderRemoval = true;

    // Capture submission before Turbo handles it, including keyboard submissions.
    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (event.defaultPrevented || !form.matches("form[data-b270-remove-reader]")) return;
      if (window.confirm(form.dataset.b270RemoveReader)) return;

      event.preventDefault();
      event.stopImmediatePropagation();
    }, true);
  })();
</script>
