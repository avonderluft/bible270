<% content_for :title, "#{@reader.display_name} — Admin" %>
<% content_for :hide_day_index, true %><%# this page has its own grid %>
<p class="b270-eyebrow"><%= link_to 'Admin', admin_path %></p>
<h1><%= @reader.display_name %></h1>
<p class="lede">
  <%= @reader.email.presence || @reader.provider %> ·
  <%= @days_completed %> of <%= Bible270::Plan::DAYS %> days ·
  <%= @reader.completion_percent %>%
  <% if @reader.today_day %>· day <%= @reader.today_day %> today
  <% elsif @reader.not_started_yet? %>· starts <%= @reader.effective_start_date.strftime('%b %-d, %Y') %>
  <% elsif @reader.past_end_date? %>· finished <%= @reader.plan_end_date.strftime('%b %-d, %Y') %><% end %>
</p>

<div class="b270-panel">
  <h2 class="b270-subhead">Name and picture</h2>
  <%= form_with url: admin_reader_profile_path(@reader), method: :patch, class: "b270-emailform",
                html: { multipart: true } do %>
    <div class="b270-avatarrow">
      <%= b270_avatar(@reader, size: 72) %>
      <% if Bible270::Reader.avatar_uploads? %>
        <label class="b270-field" style="flex:1">
          <span>Picture</span>
          <%= file_field_tag :avatar, accept: Bible270::Avatars.content_types.join(',') %>
          <span class="b270-hint" style="margin:0">
            PNG, JPEG, GIF or WebP, up to <%= Bible270::Avatars.human_size(Bible270::Avatars.max_bytes) %>.
          </span>
        </label>
      <% end %>
    </div>

    <label class="b270-field">
      <span>First name</span>
      <%= text_field_tag :first_name, @reader.suggested_names[:first_name] %>
    </label>
    <label class="b270-field">
      <span>Last name</span>
      <%= text_field_tag :last_name, @reader.suggested_names[:last_name] %>
    </label>
    <%= submit_tag 'Save', class: 'b270-btn' %>
  <% end %>

  <% if @reader.avatar_uploaded? %>
    <%= button_to "Remove picture", admin_reader_avatar_path(@reader), method: :delete,
          class: 'b270-linkbtn',
          form: { data: { turbo_confirm: "Remove #{@reader.display_name}'s picture?" } } %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Email notifications</h2>
  <% unless Bible270.config.mention_notifications %>
    <p class="b270-hint">Reflection emails are disabled for this installation.</p>
  <% else %>
    <% unless @comment_notifications_available %>
      <p class="b270-flash alert" style="margin:0">
        Run the pending Bible270 database migration before changing reflection emails.
      </p>
    <% else %>
      <% if @reader.email.blank? %>
        <p class="b270-hint">This reader does not currently have an email address.</p>
      <% end %>
      <%= form_with url: admin_reader_notifications_path(@reader), method: :patch,
                    class: "b270-emailform" do %>
        <%= render "bible270/shared/comment_notification_choices",
              level: @reader.comment_notification_level,
              personal_label: "Only replies to their reflections and mentions of them" %>
        <%= submit_tag 'Save', class: 'b270-btn' %>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Where they are in the plan</h2>
  <%= form_with url: admin_reader_start_path(@reader), method: :patch, class: "b270-startform" do %>
    <label class="b270-field">
      <span>Put them on day (as of today)</span>
      <%= number_field_tag :day, @reader.calendar_day || 1, min: 1, max: Bible270::Plan::DAYS %>
    </label>
    <%= submit_tag 'Move', class: 'b270-btn' %>
  <% end %>
  <%= form_with url: admin_reader_start_path(@reader), method: :patch, class: "b270-startform" do %>
    <label class="b270-field">
      <span>…or set the start date directly</span>
      <%= date_field_tag :start_date, @reader.started_on %>
    </label>
    <%= submit_tag 'Set date', class: 'b270-btn' %>
  <% end %>
  <p class="b270-hint">Moving someone re-maps the calendar only. Their check-offs are keyed to day
     numbers and are not touched.</p>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Completions</h2>
  <%= form_with url: admin_reader_through_path(@reader), method: :patch, class: "b270-startform" do %>
    <label class="b270-field">
      <span>Mark complete through day (0 clears everything)</span>
      <%= number_field_tag :day, @days_completed, min: 0, max: Bible270::Plan::DAYS %>
    </label>
    <%= submit_tag 'Apply', class: 'b270-btn' %>
  <% end %>
  <p class="b270-hint">This also clears anything after that day, so it sets their progress exactly.</p>

  <div class="b270-grid" style="margin-top:16px">
    <% (1..Bible270::Plan::DAYS).each do |d| %>
      <%= button_to d, admin_reader_day_path(@reader, d), method: :post,
            class: b270_day_cell_classes(d, reader: @reader),
            title: b270_day_readings(d),
            form: { style: 'display:contents', id: "day-#{d}" } %>
    <% end %>
  </div>
  <p class="b270-hint">Click a day to toggle it complete.</p>
</div>

<div class="b270-panel">
  <%= render "bible270/shared/reflections", comments: @comments, moderate: true %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Which translation they read</h2>
  <p class="b270-hint" style="margin-top:0">
    Reading links open in this translation.
    <% if @reader.bible_version.blank? %>
      They have expressed no preference, so they follow the site default
      (<%= Bible270.config.bible_version %>).
    <% end %>
  </p>

  <%= form_with url: admin_reader_version_path(@reader), method: :patch, class: "b270-form" do %>
    <div class="row">
      <%= select_tag :bible_version,
            options_for_select([["Site default (#{Bible270.config.bible_version})", ""]] +
                               Bible270::Translations.options,
                               @reader.bible_version.to_s),
            class: "b270-select", style: "width:auto" %>
    </div>
    <%= render "bible270/shared/passage_source", reader: @reader %>
    <%= submit_tag "Save", class: "b270-btn" %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Remove</h2>
  <p class="b270-hint" style="margin-top:0">Deletes the reader together with every check-off and
     reflection they have written. This cannot be undone.</p>
  <%= button_to "Remove #{@reader.display_name}", admin_reader_path(@reader), method: :delete,
        class: 'b270-btn', form: { data: { turbo_confirm: "Permanently remove #{@reader.display_name}?" } } %>
</div>

<p style="margin-top:18px"><%= link_to '← All readers', admin_path %></p>
