<% content_for :title, "Admin — #{Bible270.config.app_name}" %>
<p class="b270-eyebrow">Admin</p>
<h1>Readers</h1>
<p class="lede"><%= @readers.size %> reader<%= 's' unless @readers.size == 1 %> taking part.
   <%= link_to 'Moderate reflections →', admin_comments_path %></p>

<div class="b270-panel">
  <h2 class="b270-subhead">This run of the plan is <%= @enrollment_closed ? 'closed' : 'open' %> to new readers.</h2>
  <% if @enrollment_closed %>
    <p class="b270-startline">
      <% if @enrollment_closed_at %>Enrollment closed on <%= b270_date(@enrollment_closed_at) %>.<% end %>
      The <%= @readers.size %> reader<%= 's' unless @readers.size == 1 %> already taking part can
      still sign in and carry on.
    </p>
    <%= button_to 'Open to new readers', admin_enrollment_path, method: :patch,
          params: { state: 'open' }, class: 'b270-btn' %>
  <% else %>
    <p class="b270-startline">Anyone signing in for the first time joins this run.</p>
    <%= button_to 'Close to new readers', admin_enrollment_path, method: :patch,
          params: { state: 'closed' }, class: 'b270-btn',
          form: { data: { turbo_confirm: 'Close this run? Existing readers keep their access.' } } %>
  <% end %>
</div>

<div class="b270-panel">
  <h2 class="b270-subhead">Current run start date</h2>
  <% if @run_start_date %>
    <p class="b270-startline">
      This run <%= @run_start_date > Bible270.today ? 'starts' : 'started' %>
      <strong><%= @run_start_date.strftime('%B %-d, %Y') %></strong> and ends
      <strong><%= Bible270::Plan.end_date_for(@run_start_date).strftime('%B %-d, %Y') %></strong>.
      <% if @run_start_date_overridden %><span class="b270-badge">Admin override</span><% end %>
    </p>
  <% else %>
    <p class="b270-startline">This run is undated.</p>
  <% end %>

  <%= form_with url: admin_run_start_path, method: :patch, class: "b270-startform",
        data: { turbo_confirm: "Change the current run start date? Calendar dates, Today, and reminders will be re-mapped. Check-offs and reflections will not change." } do %>
    <label class="b270-field">
      <span>Start date</span>
      <%= date_field_tag :start_date, @run_start_date, required: true %>
    </label>
    <%= submit_tag(@run_start_date ? 'Change start date' : 'Set start date', class: 'b270-btn') %>
  <% end %>

  <p class="b270-hint">
    This affects <%= pluralize(@shared_calendar_readers, 'reader') %> following the shared calendar.
    <% if @personal_calendar_readers.positive? %>
      <%= pluralize(@personal_calendar_readers, 'reader') %> with a personal calendar will not move.
    <% end %>
    Check-offs and reflections remain attached to their existing day numbers.
  </p>

  <% if @run_start_date_overridden %>
    <%= button_to 'Use configured date', admin_run_start_path, method: :delete, class: 'b270-linkbtn',
          form: { data: { turbo_confirm: 'Remove the Admin override and use the configured start date?' } } %>
    <p class="b270-hint">
      Configured date:
      <%= @configured_start_date ? @configured_start_date.strftime('%B %-d, %Y') : 'undated' %>.
    </p>
  <% end %>
</div>

<% if @readers.any? %>
  <div class="b270-admin-reader-tools">
    <%= form_with url: admin_path, method: :get, class: "b270-admin-reader-sort" do %>
      <label>
        <span>Sort readers by</span>
        <%= select_tag :sort, options_for_select(@reader_sort_options.map { |value, label| [label, value] }, @reader_sort) %>
      </label>
      <%= submit_tag "Sort", class: "b270-btn" %>
    <% end %>
    <button type="button" class="b270-btn b270-reader-stats-open" aria-haspopup="dialog"
            aria-controls="b270-reader-stats-dialog" data-b270-reader-stats-open hidden>Reader Stats</button>
  </div>

  <div class="b270-list">
    <% @readers.each do |reader| %>
      <div class="b270-li">
        <%= link_to b270_avatar(reader, size: 72), admin_reader_path(reader),
              "aria-label": reader.display_name %>
        <div>
          <div class="name"><%= link_to reader.display_name, admin_reader_path(reader), style: 'text-decoration:none' %>
          <% if Bible270.config.admin?(reader) %> <span class="sub"><strong>[admin]</strong></span> <% end %>
          </div>
          <div class="sub">
            <% if reader.email.present? %>
              <%= mail_to reader.email %>
            <% else %>
              <%= reader.provider %>
            <% end %>
            <% if reader.dated? %>· started <%= reader.effective_start_date.strftime('%b %-d, %Y') %><% end %>
            · <%= @days_completed[reader.id] %>/<%= Bible270::Plan::DAYS %> days
            · <%= @reader_report.status_for(reader) %>
          </div>
          <div class="sub b270-reader-activity">
            <% if (activity = @recent_reader_activities[reader.id]) %>
              <%= b270_date(activity.occurred_at) %>: <%= b270_reader_activity_description(activity) %>
            <% else %>
              No reading activity yet
            <% end %>
          </div>
        </div>
        <div class="stat">
          <span class="big"><%= (@days_completed[reader.id].to_f / Bible270::Plan::DAYS * 100).round %>%</span>
        </div>
      </div>
    <% end %>
  </div>

  <dialog id="b270-reader-stats-dialog" class="b270-reader-stats-dialog"
          aria-labelledby="b270-reader-stats-title" data-b270-reader-stats-dialog>
    <div class="b270-reader-stats-content">
      <div class="b270-reader-stats-head">
        <h2 id="b270-reader-stats-title" class="b270-subhead">Reader Stats</h2>
        <form method="dialog"><button type="submit" class="b270-linkbtn">Close</button></form>
      </div>
      <pre><%= @reader_report.to_table %></pre>
    </div>
  </dialog>

  <script nonce="<%= content_security_policy_nonce %>">
    (() => {
      function scan() {
        document.querySelectorAll("[data-b270-reader-stats-open]").forEach((button) => {
          const dialog = document.getElementById(button.getAttribute("aria-controls"));
          if (dialog && typeof dialog.showModal === "function") button.hidden = false;
        });
      }

      if (window.Bible270ReaderStats) {
        scan();
        return;
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        const openButton = target.closest && target.closest("[data-b270-reader-stats-open]");
        if (openButton) {
          const dialog = document.getElementById(openButton.getAttribute("aria-controls"));
          if (dialog && typeof dialog.showModal === "function") dialog.showModal();
          return;
        }

        if (target.matches && target.matches("[data-b270-reader-stats-dialog]")) target.close();
      });
      document.addEventListener("turbo:load", scan);
      window.Bible270ReaderStats = { scan };
      scan();
    })();
  </script>
<% else %>
  <p style="color:var(--faint)">No readers yet.</p>
<% end %>

<div class="b270-panel">
  <h2 class="b270-subhead">Write a message</h2>

  <% if @reachable.zero? %>
    <p class="b270-hint" style="margin-top:0">No reader has an email address yet.</p>
  <% else %>
    <p class="b270-hint" style="margin-top:0">
      <strong><%= pluralize(@reachable, 'reader') %></strong> can receive email,
      including <strong><%= pluralize(@reachable_admins, 'admin') %></strong>.
      Messages are sent individually so each recipient can be greeted by name.
      <% if @last_broadcast_at.present? %>
        <br>Last sent <%= b270_datetime(@last_broadcast_at) %><% if @last_broadcast_subject.present? %>: <em><%= @last_broadcast_subject %></em><% end %>.
      <% end %>
    </p>

    <%= form_with url: admin_broadcast_path, method: :post, class: "b270-form",
          data: { turbo_confirm: "Send this message to the selected recipients?" } do %>
      <div class="b270-broadcast-audience">
        <label for="b270-broadcast-audience" class="b270-sr-only">Recipients</label>
        <%= select_tag :audience, options_for_select([['Write to everyone', 'everyone'], ['Write to all admins', 'admins']], 'everyone'), id: 'b270-broadcast-audience', class: 'b270-select' %>
      </div>
      <%= text_field_tag :subject, params[:subject], placeholder: "Subject", class: "b270-input" %>
      <%= text_area_tag :body, params[:body], placeholder: "What would you like to say?", rows: 6 %>
      <div class="row">
        <%= submit_tag "Send", class: "b270-btn" %>
      </div>
    <% end %>
  <% end %>
</div>

<p style="margin-top:18px"><%= link_to '← Back to the plan', root_path %></p>
