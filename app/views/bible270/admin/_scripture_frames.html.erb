<section class="b270-panel" id="b270-scripture-frames" aria-labelledby="b270-scripture-frames-heading">
  <h2 class="b270-subhead" id="b270-scripture-frames-heading">Scripture frames</h2>
  <p class="b270-hint">Hover over the bread for 3 seconds, or select it, to show a random text. Admin additions supplement the YAML defaults without changing them.</p>
  <p>
    <%= link_to 'Manage texts', admin_scripture_frames_path, class: 'b270-btn' %>
    <% if @scripture_frame_storage %>
      <%= link_to 'Add text', new_admin_scripture_frame_path, class: 'b270-btn' %>
    <% else %>
      <span class="b270-hint">Run the pending database migration to add custom texts.</span>
    <% end %>
  </p>
  <p class="b270-hint">Hover or focus a heading to read the passage; select it to keep the text open.</p>
  <% [[@custom_scripture_frames, 'Custom'], [@scripture_frame_defaults, 'Default']].each do |frames, source| %>
    <% frames.each_with_index do |frame, index| %>
      <% text_id = "b270-scripture-library-#{source.downcase}-#{index}" %>
      <article class="b270-scripture-library-entry" data-source="<%= source.downcase %>">
        <%= render 'bible270/admin/scripture_text', frame: frame, source: source, text_id: text_id %>

      </article>
    <% end %>
  <% end %>
</section>
