<svg class="b270-theme-scenery" data-scenery="dark_blue" viewBox="0 0 1600 440" preserveAspectRatio="xMaxYMax slice"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="b270-moon-halo">
      <stop offset="0" stop-color="#c7d8ec" stop-opacity=".16" />
      <stop offset=".45" stop-color="#9fb7d3" stop-opacity=".07" />
      <stop offset="1" stop-color="#9fb7d3" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="b270-lake-water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#526e91" stop-opacity=".14" />
      <stop offset="1" stop-color="#526e91" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="b270-moon-reflection" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c6d6e9" stop-opacity=".3" />
      <stop offset=".5" stop-color="#abc3df" stop-opacity=".17" />
      <stop offset="1" stop-color="#abc3df" stop-opacity="0" />
    </linearGradient>
    <filter id="b270-water-far" x="-20%" y="-50%" width="140%" height="200%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency=".008 .14" numOctaves="1" seed="7" result="ripples" />
      <feDisplacementMap in="SourceGraphic" in2="ripples" scale="2" xChannelSelector="R" yChannelSelector="G" />
      <feGaussianBlur stdDeviation=".15" />
    </filter>
    <filter id="b270-water-middle" x="-20%" y="-50%" width="140%" height="200%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency=".008 .14" numOctaves="1" seed="7" result="ripples" />
      <feDisplacementMap in="SourceGraphic" in2="ripples" scale="5" xChannelSelector="R" yChannelSelector="G" />
      <feGaussianBlur stdDeviation=".45" />
    </filter>
    <filter id="b270-water-near" x="-20%" y="-50%" width="140%" height="200%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency=".008 .14" numOctaves="1" seed="7" result="ripples" />
      <feDisplacementMap in="SourceGraphic" in2="ripples" scale="9" xChannelSelector="R" yChannelSelector="G" />
      <feGaussianBlur stdDeviation="1.1" />
    </filter>
    <mask id="b270-greek-reflection" maskUnits="userSpaceOnUse" x="0" y="240" width="1600" height="200">
      <g fill="white" font-family="Georgia, Times New Roman, serif" font-size="28" text-anchor="middle">
        <g filter="url(#b270-water-far)">
          <text transform="translate(1510 250) scale(.38 -.22)">ΟΛΟΓΟΣ</text>
          <text transform="translate(1510 270) scale(.5 -.28)">ΘΕΟΣΗΝ</text>
        </g>
        <g filter="url(#b270-water-middle)">
          <text transform="translate(1510 293) scale(.66 -.36)">ΘΕΟΝΚΑΙ</text>
          <text transform="translate(1510 319) scale(.8 -.44)">ΗΝΠΡΟΣΤΟΝ</text>
          <text transform="translate(1510 348) scale(.95 -.54)">ΚΑΙΟΛΟΓΟΣ</text>
        </g>
        <g filter="url(#b270-water-near)">
          <text transform="translate(1510 380) scale(1.1 -.68)">ΗΝΟΛΟΓΟΣ</text>
          <text transform="translate(1510 411) scale(1.4 -.85)">ΕΝΑΡΧΗ</text>
        </g>
      </g>
    </mask>
    <radialGradient id="b270-moon-mobile-glow">
      <stop offset="0" stop-color="#c6d6e9" stop-opacity=".18" />
      <stop offset=".5" stop-color="#abc3df" stop-opacity=".07" />
      <stop offset="1" stop-color="#abc3df" stop-opacity="0" />
    </radialGradient>
    <clipPath id="b270-lake-clip">
      <rect y="240" width="1600" height="200" />
    </clipPath>
  </defs>
  <circle cx="1510" cy="162" r="105" fill="url(#b270-moon-halo)" />
  <circle id="b270-midnight-moon" cx="1510" cy="162" r="31" fill="#c7d5e5" opacity=".55" />
  <g fill="#71869d" opacity=".1">
    <ellipse cx="1501" cy="155" rx="9" ry="12" />
    <ellipse cx="1518" cy="173" rx="11" ry="7" />
  </g>
  <path id="b270-lake-shore" fill="#0c1829" opacity=".42"
        d="M0 224Q110 201 230 216T465 220 710 226 950 215 1190 222 1420 224 1600 218V240H0Z" />
  <rect y="240" width="1600" height="200" fill="url(#b270-lake-water)" />
  <path d="M0 240H1600" stroke="#8fa7c3" stroke-width=".7" opacity=".12" />
  <g clip-path="url(#b270-lake-clip)">
    <ellipse cx="1510" cy="305" rx="145" ry="125" fill="url(#b270-moon-halo)" opacity=".6" />
    <rect id="b270-lake-reflection" fill="url(#b270-moon-reflection)"
          x="0" y="240" width="1600" height="200" mask="url(#b270-greek-reflection)" />
    <%# Phones use a quiet pool of moonlight instead of the reflected scripture. %>
    <ellipse class="b270-mobile-scenery" cx="1510" cy="332" rx="65" ry="92" fill="url(#b270-moon-mobile-glow)" />
    <%# The rippled letters supply the desktop water texture without straight lines crossing the reflections. %>
  </g>
</svg>

