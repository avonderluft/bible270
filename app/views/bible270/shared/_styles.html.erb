<style>
  .b270{
    --paper:#ece6da; --card:#f4efe6; --ink:#231f18; --muted:#6d6558; --faint:#9a9082;
    --line:#d7cfbf; --line-soft:#e2dbcd; --teal:#2f6a67; --oxblood:#8a2f3b; --gold:#a5812c;
    --gold-lite:#c6a24a; --shadow:0 1px 0 rgba(35,31,24,.04),0 10px 30px -18px rgba(35,31,24,.35);
    margin:0; background:radial-gradient(120% 80% at 100% 0%,rgba(165,129,44,.06),transparent 55%),var(--paper);
    color:var(--ink); font-family:"Inter",system-ui,sans-serif; line-height:1.2; -webkit-font-smoothing:antialiased;
  }
  .b270 *{box-sizing:border-box}
  /* Blanket anchor colour. NB: this is (0,1,1), so any single-class rule
     colouring an <a> (.b270-btn, .b270-cell, .b270-arrow ...) must be
     qualified with .b270 to outrank it, or the link inherits body colour. */
  .b270 a{color:inherit}
  .b270-wrap{max-width:820px;margin:0 auto;padding:clamp(14px,3.5vw,36px) clamp(14px,4vw,40px) 64px}

  .b270-topbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding-bottom:20px;border-bottom:1px solid var(--line-soft);margin-bottom:26px}
  .b270-brand{display:flex;margin-right:auto}
  /* The whole brand is one link, so the mark and the words highlight together. */
  .b270-brandlink{display:flex;align-items:center;gap:12px;text-decoration:none}
  .b270-brandtext{display:flex;flex-direction:column}
  .b270-mark{display:flex;align-items:center;flex:none;line-height:0}
  .b270-mark svg,.b270-mark img{display:block;border-radius:8px}
  .b270-title{font-family:"Spectral",Georgia,serif;font-weight:600;font-size:22px;text-decoration:none}
  .b270-tagline{font-size:12px;color:var(--faint);letter-spacing:.04em}
  .b270-nav{display:flex;align-items:center;gap:16px;font-size:14px}
  .b270-nav a{color:var(--muted);text-decoration:none}
  .b270-nav a:hover{color:var(--gold)}
  /* button_to renders a form; make it a flex item so the button sits on the same
     line as the links, and drop the margin/underline the shared class carries. */
  .b270-nav form{display:flex;align-items:center;margin:0}
  .b270-nav .b270-linkbtn{margin:0;padding:0;font-size:14px;color:var(--muted);text-decoration:none;line-height:1}
  .b270-nav .b270-linkbtn:hover{color:var(--gold)}
  .b270-signin,.b270-me{color:var(--ink)!important;font-weight:600}

  .b270-subhead{font-family:"Spectral",serif;font-size:17px;font-weight:600;margin:0 0 4px}
  .b270-avatarrow{display:flex;align-items:center;gap:14px}
  .b270-avatarrow input[type=file]{font:inherit;font-size:13px;max-width:100%}
  .b270-emailform{display:grid;gap:12px;max-width:340px;margin:12px 0 0}
  .b270-field{display:grid;gap:5px;font-size:12.5px;color:var(--muted)}
  .b270-field input{font:inherit;font-size:15px;padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);width:100%}
  .b270-field input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(165,129,44,.13)}
  .b270-emailform input[type=submit]{justify-self:start}
  .b270-or{display:flex;align-items:center;gap:12px;margin:22px 0 18px;color:var(--faint);font-size:12px;letter-spacing:.1em;text-transform:uppercase}
  .b270-or::before,.b270-or::after{content:"";flex:1;height:1px;background:var(--line-soft)}
  .b270-providers{display:grid;gap:10px;max-width:340px}
  .b270 .b270-provider{display:block;width:100%;text-align:center;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:10px;padding:12px 16px;font:inherit;font-weight:600;font-size:14.5px;cursor:pointer;transition:border-color .15s,transform .05s}
  .b270-provider:hover{border-color:var(--gold);color:var(--gold)}
  .b270-provider:active{transform:translateY(1px)}
  .b270 .b270-signinbtn{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:7px 13px;font:inherit;font-weight:600;font-size:13px;cursor:pointer}
  .b270-signinbtn:hover{border-color:var(--gold);color:var(--gold)}
  .b270-signin-hint a{color:var(--gold);font-weight:600}
  .b270-flash{border-radius:10px;padding:11px 15px;margin-bottom:18px;font-size:14px}
  .b270-flash.alert{background:#f6e4e2;color:#7a2b28;border:1px solid #e6c3bf}
  .b270-flash.notice{background:#e7efe6;color:#2f5d34;border:1px solid #c6dcc6}

  .b270-eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:600;margin:0 0 10px}
  .b270 h1{font-family:"Spectral",serif;font-weight:600;font-size:clamp(22px,6vw,33px);line-height:1.03;letter-spacing:-.01em;margin:0 0 6px}
  .b270 h1 em{font-style:italic;color:var(--muted);font-weight:400}
  .b270 .lede{color:var(--muted);max-width:77ch;margin:0 0 24px;font-size:15px}

  .b270-panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow);margin-bottom:24px}
  .b270-bignum{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .b270-bignum .n{font-family:"Spectral",serif;font-size:38px;font-weight:600;line-height:1}
  .b270-bignum .of{color:var(--muted);font-size:15px}
  .b270-bignum .pct{margin-left:auto;color:var(--gold);font-weight:600;font-variant-numeric:tabular-nums}
  .b270-signedout{color:var(--muted);font-size:14px;margin:4px 0 0}

  .b270-startdate{margin-top:18px;padding-top:16px;border-top:1px solid var(--line-soft)}
  .b270-startline{margin:0;font-size:13.5px;color:var(--muted)}
  .b270-startline strong{color:var(--ink)}
  .b270-startline em{font-style:normal;color:var(--gold);font-weight:600}
  .b270-startedit{margin-top:10px}
  .b270-startedit summary{cursor:pointer;font-size:13px;color:var(--muted);list-style:none}
  .b270-startedit summary::-webkit-details-marker{display:none}
  .b270-startedit summary:hover{color:var(--gold)}
  .b270-startform{display:flex;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap}
  .b270-startform input[type=date]{font:inherit;font-size:14px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}
  .b270-linkbtn{background:none;border:none;padding:0;margin-top:8px;font:inherit;font-size:12.5px;color:var(--oxblood);cursor:pointer;text-decoration:underline}
  .b270-hint{margin:8px 0 0;font-size:12px;color:var(--faint);max-width:111ch}
  .b270-tracks{margin-top:16px;display:grid;gap:11px}
  .b270-tm{display:grid;grid-template-columns:130px 1fr auto;align-items:center;gap:12px;font-size:12.5px}
  .b270-tm .lab{color:var(--muted);display:flex;align-items:center;gap:8px}
  .b270-rib{width:11px;height:11px;border-radius:2px;flex:none}
  .b270-bar{height:6px;border-radius:4px;background:var(--line-soft);overflow:hidden}
  .b270-bar>i{display:block;height:100%;border-radius:4px}
  .b270-tm .val{color:var(--faint);font-variant-numeric:tabular-nums;min-width:56px;text-align:right}

  /* day nav */
  .b270-daynav{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  .b270 .b270-arrow{width:38px;height:38px;border-radius:10px;border:1px solid var(--line);background:var(--card);cursor:pointer;font-size:17px;color:var(--muted);display:grid;place-items:center;text-decoration:none}
  .b270-arrow:hover{border-color:var(--gold);color:var(--gold)}
  .b270-arrow.disabled{opacity:.35;pointer-events:none}
  .b270-dayhead{flex:1}
  .b270-dayhead .k{display:flex;align-items:center;flex-wrap:wrap;gap:9px;font-family:"Spectral",serif;font-size:24px;font-weight:600;line-height:1}
  .b270-dayhead .date{display:flex;align-items:center;flex-wrap:wrap;gap:9px;color:var(--faint);font-size:13px;margin-top:4px}
  .b270-dayhead .b270-badge{margin-left:0}
  .b270-badge{display:inline-block;vertical-align:middle;line-height:1;font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--gold-lite);padding:5px 8px 4px;border-radius:20px;margin-left:9px}

  /* readings */
  .b270-readings{background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}
  .b270-reading{display:flex;gap:15px;align-items:center;padding:16px 20px;border-left:4px solid transparent}
  .b270-reading+.b270-reading{border-top:1px solid var(--line-soft)}
  .b270-reading.ot{border-left-color:var(--teal)} .b270-reading.nt{border-left-color:var(--oxblood)} .b270-reading.pp{border-left-color:var(--gold)}
  .b270-reading.rest{opacity:.65}
  .b270-toggle{border:none;background:none;padding:0;cursor:pointer}
  .b270-toggle form{margin:0}
  .b270-check{width:26px;height:26px;border-radius:8px;border:2px solid var(--line);flex:none;display:grid;place-items:center;background:#fff;transition:all .18s}
  .b270-check svg{width:15px;height:15px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round;opacity:0}
  .b270-reading.done.ot .b270-check{background:var(--teal);border-color:var(--teal)}
  .b270-reading.done.nt .b270-check{background:var(--oxblood);border-color:var(--oxblood)}
  .b270-reading.done.pp .b270-check{background:var(--gold);border-color:var(--gold)}
  .b270-reading.done .b270-check svg{opacity:1}
  .b270-rbody{flex:1;min-width:0}
  .b270-cat{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);font-weight:600}
  .b270-ref{font-family:"Spectral",serif;font-size:19px;font-weight:500;margin-top:1px}
  /* per-chapter check-offs: a smaller box per chapter, listed under the track */
  /* A multi-chapter reading is laid out as a block rather than a flex row, so
     each chapter's box sits in the same column as the single box on the other
     tracks. The label is indented by that column's width (26px) plus the row
     gap (15px) to stay level with the other tracks' labels. */
  .b270-reading.multi{display:block}
  .b270-reading.multi .b270-cat{margin-left:41px}
  .b270-reading.multi .b270-parts-meta{margin-left:41px}
  .b270-parts{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
  .b270-part{display:flex;align-items:center;gap:15px}
  .b270-part .b270-ref{font-size:19px}
  /* A ticked chapter looks exactly like a ticked single reading: the box fills
     in the track's colour and the tick appears. No strikethrough — the other
     tracks don't strike their references either. */
  .b270-reading.ot .b270-part.done .b270-check{background:var(--teal);border-color:var(--teal)}
  .b270-reading.nt .b270-part.done .b270-check{background:var(--oxblood);border-color:var(--oxblood)}
  .b270-reading.pp .b270-part.done .b270-check{background:var(--gold);border-color:var(--gold)}
  .b270-part.done .b270-check svg{opacity:1}
  .b270-parts-meta{margin-top:10px;font-size:12.5px;color:var(--faint)}
  .b270-version{font-size:11.5px;color:var(--faint);font-weight:400;letter-spacing:.02em;white-space:nowrap}
  .b270-select{font:inherit;font-size:14px;padding:10px 30px 10px 12px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);width:100%;max-width:100%;text-overflow:ellipsis}
  .b270-source-choices{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin:8px 0 2px;color:var(--muted);font-size:12.5px}
  .b270-source-choice{display:inline-flex;align-items:center;gap:7px;cursor:pointer;white-space:nowrap}
  .b270-source-choice input{appearance:none;width:17px;height:17px;margin:0;border:1px solid var(--line);border-radius:3px;background:#fff;display:grid;place-content:center;cursor:pointer}
  .b270-source-choice input::before{content:"";width:9px;height:9px;transform:scale(0);transition:transform .1s;clip-path:polygon(14% 44%,0 59%,38% 100%,100% 18%,82% 0,37% 65%);background:var(--paper)}
  .b270-source-choice input:checked{background:var(--gold);border-color:var(--gold)}
  .b270-source-choice input:checked::before{transform:scale(1)}
  .b270-source-choice input:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
  .b270-source-choice.disabled{cursor:default;opacity:.55}
  .b270-source-choice input:disabled{cursor:default}
  .b270-ref a{text-decoration:none;border-bottom:1px solid transparent}
  .b270-ref a:hover{border-bottom-color:var(--gold)}
  .b270-reading.done .b270-ref{color:var(--muted)}
  .b270-reading.rest .b270-ref{font-style:italic;font-size:16px;color:var(--faint)}
  .b270 .b270-signin-hint{font-size:12px;color:var(--faint)}

  /* completers */
  .b270-completers{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:13px;color:var(--muted)}
  .b270-avatar{border-radius:50%;object-fit:cover;display:inline-block;text-align:center;background:var(--teal);color:#fff;font-size:12px;font-weight:600}
  .b270-avatar-fallback{border-radius:50%}

  /* comments */
  .b270-section-h{font-family:"Spectral",serif;font-size:20px;font-weight:600;margin:34px 0 14px}
  .b270-comment{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line-soft)}
  .b270-comment:first-child{border-top:none}
  .b270-cmeta{font-size:13px;color:var(--muted)}
  .b270-cmeta strong{color:var(--ink)}
  /* Replies sit indented under their parent, with a rule down the left so a
     thread reads as one block rather than a run of separate reflections. */
  .b270-replies{margin:10px 0 0}
  .b270-replies:empty{margin:0}
  .b270-comment.b270-reply{padding:10px 0 0 16px;border-top:none;border-left:2px solid var(--line-soft);gap:10px}
  .b270-comment.b270-reply .b270-cbody{font-size:14.5px}
  .b270-replying{margin:0 0 8px;font-size:13px;color:var(--muted)}
  .b270-replying strong{color:var(--ink)}
  .b270-mention{color:var(--teal);font-weight:600;text-decoration:none}
  .b270-mention:hover{text-decoration:underline}
  .b270-cactions{display:flex;align-items:center;gap:12px;margin-top:6px;flex-wrap:wrap}
  .b270-likes{display:inline-flex;align-items:center;gap:3px;position:relative}
  .b270-heart{font-size:13px;line-height:1;cursor:default}
  /* The single heart is also the toggle for signed-in readers. Unliked, it is
     desaturated so the reader can still tell whether their own like is active. */
  .b270-likebtn{background:none;border:0;padding:0 2px;font-size:13px;line-height:1;cursor:pointer;
                filter:grayscale(1);opacity:.5;transition:filter .12s,opacity .12s}
  .b270-likebtn:hover{filter:none;opacity:1}
  .b270-likebtn.liked{filter:none;opacity:1}
  .b270-likecount{font-size:11.5px;color:var(--faint)}
  .b270-liketooltip{display:none;position:absolute;z-index:10;top:calc(100% + 6px);left:0;
                    min-width:max-content;padding:6px 9px;border:1px solid var(--line-soft);
                    border-radius:7px;background:var(--ink);color:var(--paper);font-size:12px;
                    line-height:1.45;box-shadow:0 3px 10px rgba(0,0,0,.14)}
  .b270-likes:hover .b270-liketooltip,.b270-likes:focus-within .b270-liketooltip{display:block}
  .b270-liker{display:block;white-space:nowrap}
  .b270-creply{margin-top:6px}
  .b270-cbody{margin:3px 0 0;white-space:pre-wrap}
  .b270-editform{margin-top:6px}
  .b270-editform textarea{min-height:64px}
  .b270-editerror{margin:0 0 8px;font-size:13px;color:var(--oxblood)}
  .b270-cedit{font-size:12px;color:var(--muted);margin-left:8px}
  .b270-cedit:hover{color:var(--gold)}
  .b270-edited{font-style:italic;color:var(--faint)}
  .b270-comment.b270-editing{background:rgba(165,129,44,.05);border-radius:10px;padding:12px}
  .b270-editing textarea{min-height:64px}
  .b270-cdel{font-size:12px;color:var(--oxblood);background:none;border:none;cursor:pointer;padding:0;margin-left:8px}
  .b270-input{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;background:#fff;font:inherit;font-size:14px;margin-bottom:8px}
  .b270-form textarea{width:100%;font:inherit;font-size:15px;border:1px solid var(--line);border-radius:10px;padding:11px 13px;background:#fff;resize:vertical;min-height:76px}
  .b270-form .row{display:flex;align-items:center;gap:10px;margin-top:10px}
  .b270 .b270-btn{border:none;border-radius:10px;padding:8px 16px;margin-top:4px;font:inherit;font-weight:600;font-size:14px;cursor:pointer;background:var(--ink);color:var(--paper);text-decoration:none;display:inline-block}
  .b270-btn:hover{background:#3a352b}

  /* community */
  .b270-list{background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}
  .b270-li{display:flex;align-items:center;gap:14px;padding:14px 18px}
  .b270-li+.b270-li{border-top:1px solid var(--line-soft)}
  .b270-li .name{font-weight:600}
  .b270-li .sub{font-size:12.5px;color:var(--faint)}
  .b270-li .stat{margin-left:auto;text-align:right}
  .b270-li .stat .big{font-family:"Spectral",serif;font-size:20px;font-weight:600}
  .b270-li .rank{width:26px;color:var(--faint);font-variant-numeric:tabular-nums;text-align:center}

  /* calendar grid */
  .b270-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(30px,1fr));gap:6px;margin-top:16px}
  .b270 .b270-cell{aspect-ratio:1;border-radius:6px;border:1px solid var(--line);background:var(--card);font-size:10.5px;color:var(--faint);display:grid;place-items:center;text-decoration:none;font-variant-numeric:tabular-nums}
  .b270-cell:hover{border-color:var(--gold);color:var(--gold)}
  .b270-cell.partial{background:linear-gradient(135deg,var(--card) 50%,rgba(165,129,44,.35) 50%);color:var(--muted)}
  .b270-cell.complete{background:var(--teal);border-color:var(--teal);color:#eef3f2;font-weight:600}
  /* Days that have reflections carry a dot and nothing else: the fill stays
     free to mean reading progress, so the two facts never compete. On a finished
     square the dot goes pale, since oxblood on teal is hard to pick out. */
  .b270-cell.talk{position:relative}
  .b270-cell.talk::after{content:"";position:absolute;top:3px;right:3px;width:7px;height:7px;border-radius:50%;background:var(--oxblood)}
  .b270-cell.talk.complete::after{background:#f4efe6}
  .b270-cell.now{box-shadow:0 0 0 2px var(--gold)}

  /* On the Reflections page each thread carries the day it belongs to, since
     there is no day heading above it. */
  .b270-thread{margin-bottom:8px}
  .b270-threadday{margin:0;font-size:12px;letter-spacing:.04em;color:var(--faint)}
  .b270-threadday a{color:var(--gold);font-weight:600;text-decoration:none}
  .b270-threadday a:hover{text-decoration:underline}
  /* Scripture references stay undecorated, hover included, so a line of three of
     them does not read as a row of buttons. */
  .b270-threadday .b270-reflink,
  .b270-threadday .b270-reflink:hover{color:var(--muted);font-weight:400;text-decoration:none}
  .b270-threadday .b270-reflink:hover{color:var(--ink)}
  .b270-gridnote{margin:10px 0 0;font-size:11.5px;color:var(--faint)}

  .b270-footer{margin-top:20px;padding-top:11px;border-top:1px solid var(--line-soft);color:var(--faint);font-size:13px}
  .b270-footer p{margin:0;line-height:1.5}
  details.b270-index summary{cursor:pointer;font-family:"Spectral",serif;font-size:18px;font-weight:600;list-style:none;margin-top:30px}
  details.b270-index summary::-webkit-details-marker{display:none}
  @media (max-width:480px){ .b270-tm{grid-template-columns:104px 1fr auto} .b270-reading{padding:14px 15px;gap:12px} .b270-reading.multi .b270-cat,.b270-reading.multi .b270-parts-meta{margin-left:38px} .b270-part{gap:12px} }
</style>
