<header class="b270-topbar">
  <div class="b270-brand">
    <%= link_to root_path, class: "b270-brandlink" do %>
      <%= b270_mark %>
      <span class="b270-title"><%= Bible270.config.app_name %></span>
    <% end %>
  </div>
  <nav class="b270-nav" aria-label="Primary navigation">
    <div class="b270-desktopnav">
      <%= render "bible270/shared/nav_links" %>
    </div>
    <div class="b270-navmenu">
      <button type="button" class="b270-navtoggle" aria-label="Menu"
              aria-expanded="false" aria-controls="b270-mobile-navigation">
        <svg class="b270-menuicon" viewBox="0 0 18 14" width="18" height="14"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             aria-hidden="true" focusable="false">
          <path d="M1 1h16M1 7h16M1 13h16" />
        </svg>
      </button>
      <div id="b270-mobile-navigation" class="b270-navlinks" hidden>
        <%= render "bible270/shared/nav_links" %>
      </div>
    </div>
  </nav>
</header>

<script nonce="<%= content_security_policy_nonce %>">
  (() => {
    if (window.Bible270NavigationMenu) return;

    function setExpanded(menu, expanded) {
      const toggle = menu && menu.querySelector("button.b270-navtoggle");
      const links = menu && menu.querySelector(".b270-navlinks");
      if (!toggle || !links) return;

      toggle.setAttribute("aria-expanded", String(expanded));
      links.hidden = !expanded;
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      document.querySelectorAll(".b270-navmenu").forEach((menu) => {
        if (!menu.contains(target)) setExpanded(menu, false);
      });

      const toggle = target.closest && target.closest("button.b270-navtoggle");
      if (!toggle) return;

      setExpanded(toggle.closest(".b270-navmenu"), toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || event.defaultPrevented) return;

      const menu = event.target.closest && event.target.closest(".b270-navmenu");
      const toggle = menu && menu.querySelector("button.b270-navtoggle");
      if (!toggle || toggle.getAttribute("aria-expanded") !== "true") return;

      const restoreFocus = menu.contains(document.activeElement);
      setExpanded(menu, false);
      event.preventDefault();
      if (restoreFocus) toggle.focus();
    });

    window.Bible270NavigationMenu = true;
  })();
</script>
