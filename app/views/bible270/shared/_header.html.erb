<header class="b270-topbar">
  <div class="b270-brand">
    <%= link_to root_path, class: "b270-brandlink" do %>
      <%= b270_mark %>
      <span class="b270-title"><%= Bible270.config.app_name %></span>
    <% end %>
  </div>
  <nav class="b270-nav" aria-label="Primary navigation">
    <div class="b270-desktopnav">
      <%= render "bible270/shared/nav_links" %>
    </div>
    <details class="b270-navmenu">
      <summary class="b270-navtoggle" aria-label="Menu">
        <span class="b270-menuicon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </summary>
      <div class="b270-navlinks">
        <%= render "bible270/shared/nav_links" %>
      </div>
    </details>
  </nav>
</header>

<script nonce="<%= content_security_policy_nonce %>">
  (() => {
    if (window.Bible270NavigationMenu) return;

    document.addEventListener("click", (event) => {
      const target = event.target;
      const toggle = target.closest && target.closest("summary.b270-navtoggle");
      if (!toggle) return;

      const menu = toggle.closest("details.b270-navmenu");
      if (!menu) return;

      event.preventDefault();
      menu.open = !menu.open;
    });

    window.Bible270NavigationMenu = true;
  })();
</script>
