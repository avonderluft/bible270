<script nonce="<%= content_security_policy_nonce %>" data-refresh-path="<%= refresh_session_path %>">
  (() => {
    const refreshSessionPath = document.currentScript.dataset.refreshPath;
    if (window.Bible270InteractionUI) {
      window.Bible270InteractionUI.reset();
      return;
    }

    function statusRegion() {
      return document.getElementById("b270-interaction-status");
    }

    function announce(message, state = "") {
      const region = statusRegion();
      if (!region) return;

      region.textContent = message || "";
      region.dataset.state = state;
    }

    function resetForm(form) {
      form.removeAttribute("aria-busy");
      form.dataset.b270Submitting = "false";
      form.querySelectorAll("[data-b270-disabled-by-submit]").forEach((control) => {
        control.disabled = false;
        delete control.dataset.b270DisabledBySubmit;
      });
    }

    function reset() {
      document.querySelectorAll("form[data-b270-submit='true']").forEach(resetForm);
    }

    const SESSION_REFRESH_AFTER = 5 * 60 * 1000;
    let sessionRefreshedAt = Date.now();
    let sessionRefresh = null;
    let hiddenAt = null;
    const submitters = new WeakMap();

    function updateAuthenticityToken(token) {
      const meta = document.querySelector("meta[name='csrf-token']");
      if (meta) meta.content = token;
      document.querySelectorAll("input[name='authenticity_token']").forEach((input) => {
        input.value = token;
      });
    }

    function refreshSession() {
      if (sessionRefresh) return sessionRefresh;

      sessionRefresh = fetch(refreshSessionPath, {
        credentials: "same-origin",
        cache: "no-store",
        headers: { Accept: "text/plain" }
      }).then((response) => {
        const token = response.headers.get("X-CSRF-Token");
        if (!response.ok || !token) throw new Error("Could not refresh the session");

        updateAuthenticityToken(token);
        sessionRefreshedAt = Date.now();
      }).finally(() => {
        sessionRefresh = null;
      });
      return sessionRefresh;
    }

    function sessionRefreshNeeded() {
      return Date.now() - sessionRefreshedAt >= SESSION_REFRESH_AFTER;
    }

    let scriptureWindow = null;
    const replacesBackgroundTabs = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    document.addEventListener("click", (event) => {
      const target = event.target;
      const link = target.closest && target.closest("a[data-b270-passage-link='true']");
      if (!link || event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      try {
        if (replacesBackgroundTabs && scriptureWindow && !scriptureWindow.closed) {
          scriptureWindow.close();
          scriptureWindow = null;
        }

        if (!scriptureWindow || scriptureWindow.closed) {
          scriptureWindow = window.open(link.href, "_blank");
          if (!scriptureWindow) return;
        } else {
          scriptureWindow.location = link.href;
        }
        event.preventDefault();
        scriptureWindow.focus();
      } catch (_error) {
        scriptureWindow = null;
      }
    });

    document.addEventListener("submit", (event) => {
      const submittedForm = event.target.closest("form");
      if (submittedForm && event.submitter) submitters.set(submittedForm, event.submitter);

      const form = event.target.closest("form[data-b270-submit='true']");
      if (!form) return;

      if (sessionRefresh || sessionRefreshNeeded()) {
        event.preventDefault();
        if (form.dataset.b270AwaitingSession === "true") return;

        form.dataset.b270AwaitingSession = "true";
        const submitter = event.submitter;
        refreshSession().then(() => {
          delete form.dataset.b270AwaitingSession;
          form.requestSubmit(submitter || undefined);
        }).catch(() => {
          delete form.dataset.b270AwaitingSession;
          window.location.reload();
        });
        return;
      }

      if (form.dataset.b270Submitting === "true") {
        event.preventDefault();
        return;
      }

      form.dataset.b270Submitting = "true";
      form.setAttribute("aria-busy", "true");
      const submitter = event.submitter || form.querySelector("button[type='submit'],input[type='submit']");
      if (submitter) {
        submitter.disabled = true;
        submitter.dataset.b270DisabledBySubmit = "true";
      }
      announce(form.dataset.b270Pending || "Saving…", "pending");
    });

    function staleSessionResponse(fetchResponse) {
      if (!fetchResponse) return false;

      const response = fetchResponse.response;
      if (fetchResponse.statusCode === 409 &&
          response.headers.get("X-Bible270-Refresh-Session") === "true") return true;

      // Older deployments can still return Rails' HTML 422 page. Do not confuse
      // an intentional Turbo Stream validation response with an expired session.
      const contentType = response.headers.get("Content-Type") || "";
      return fetchResponse.statusCode === 422 && contentType.includes("text/html");
    }

    document.addEventListener("turbo:before-fetch-response", (event) => {
      const target = event.target;
      const form = target.closest && target.closest("form");
      const response = event.detail.fetchResponse;
      if (!form || form.method.toLowerCase() === "get" || !staleSessionResponse(response)) return;

      event.preventDefault();
      if (form.dataset.b270RetriedAfterStaleSession === "true") {
        window.location.reload();
        return;
      }

      const submitter = submitters.get(form);
      form.dataset.b270RetriedAfterStaleSession = "true";
      resetForm(form);
      refreshSession()
        .then(() => form.requestSubmit(submitter || undefined))
        .catch(() => window.location.reload());
    });

    document.addEventListener("turbo:submit-end", (event) => {
      const form = event.target;
      if (!form.matches("form[data-b270-submit='true']")) return;

      resetForm(form);
      if (form.dataset.b270RetriedAfterStaleSession === "true" &&
          staleSessionResponse(event.detail.fetchResponse)) return;

      delete form.dataset.b270RetriedAfterStaleSession;
      if (event.detail.success) {
        announce(form.dataset.b270Success || "Saved.", "success");
      } else {
        announce(form.dataset.b270Failure || "Couldn’t save that. Try again.", "error");
      }
    });

    window.addEventListener("pageshow", (event) => {
      reset();
      if (event.persisted) refreshSession().catch(() => {});
    });
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        hiddenAt = Date.now();
      } else if (hiddenAt && Date.now() - hiddenAt >= SESSION_REFRESH_AFTER) {
        refreshSession().catch(() => {});
        hiddenAt = null;
      }
    });
    document.addEventListener("turbo:load", reset);

    window.Bible270InteractionUI = { reset };
    reset();
  })();
</script>
