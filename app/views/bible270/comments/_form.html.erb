<% draft_key = ["bible270", "draft", "v1", Bible270.config.mount_at, current_reader.id,
                    day, comment.parent_id.presence || "root"].join(":") %>
<% posting_reply = comment.parent_id.present? %>
<%= form_with model: comment, url: day_comments_path(day), method: :post,
      id: "new_comment_form", class: "b270-form",
      data: { turbo_stream: true, b270_draft: true, b270_draft_key: draft_key,
              b270_draft_errors: comment.errors.any?, b270_draft_posted: local_assigns.fetch(:posted, false),
              b270_submit: true, b270_pending: (posting_reply ? "Posting reply…" : "Posting reflection…"),
              b270_success: (posting_reply ? "Reply posted." : "Reflection posted."),
              b270_failure: (posting_reply ? "Couldn’t post the reply. Try again." : "Couldn’t post the reflection. Try again.") } do |f| %>
  <% if comment.errors.any? %>
    <p style="color:var(--oxblood);font-size:13px"><%= comment.errors.full_messages.to_sentence %></p>
  <% end %>
  <% if comment.parent_id.present? && (parent = Bible270::Comment.find_by(id: comment.parent_id)) %>
    <p class="b270-replying">
      Replying to <strong><%= parent.reader.display_name %></strong>
      · <%= link_to "cancel", day_path(day, anchor: "new_comment_form") %>
    </p>
  <% end %>
  <%= f.hidden_field :parent_id %>
  <div class="b270-mention-composer" data-b270-mention-composer
       data-suggestions-url="<%= mention_suggestions_path %>">
    <%= f.label :body, (posting_reply ? "Reply" : "Reflection"), class: "b270-sr-only" %>
    <%= f.text_area :body,
          placeholder: posting_reply ? "Write your reply…" : "Share a reflection on today's reading…",
          role: "combobox", autocomplete: "off",
          aria: { autocomplete: "list", expanded: "false", haspopup: "listbox",
                  controls: "b270-mention-options" } %>
    <div class="b270-mention-options" id="b270-mention-options" role="listbox"
         data-b270-mention-options hidden></div>
    <p class="b270-sr-only" data-b270-mention-status aria-live="polite"></p>
  </div>
  <p class="b270-draft-status" data-b270-draft-status aria-live="polite"></p>
  <div class="row">
    <%= f.select :track,
          options_for_select([["The whole day", ""]] + Bible270::Plan::TRACKS.map { |k, v| [v[:label], k] }),
          {}, style: "font:inherit;padding:8px;border:1px solid var(--line);border-radius:8px;background:#fff" %>
    <%= f.submit "Post reflection", class: "b270-btn" %>
  </div>
<% end %>
