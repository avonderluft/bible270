<% content_for :title, "Profile — #{Bible270.config.app_name}" %>
<p class="b270-eyebrow">Profile</p>
<h1>Your details</h1>
<p class="lede">This is how you appear beside your reflections and on the community page.</p>

<div class="b270-panel">
  <%= form_with url: profile_path, method: :patch, class: "b270-emailform",
                html: { multipart: true } do %>
    <div class="b270-avatarrow">
      <%= b270_avatar(current_reader, size: 72) %>
      <% if Bible270::Reader.avatar_uploads? %>
        <label class="b270-field" style="flex:1">
          <span>Picture</span>
          <%= file_field_tag :avatar, accept: Bible270::Avatars.content_types.join(',') %>
          <span class="b270-hint" style="margin:0">
            PNG, JPEG, GIF or WebP, up to <%= Bible270::Avatars.human_size(Bible270::Avatars.max_bytes) %>.
          </span>
        </label>
      <% end %>
    </div>


    <label class="b270-field">
      <span>First name</span>
      <%= text_field_tag :first_name, @names[:first_name], required: true, autocomplete: "given-name" %>
    </label>
    <label class="b270-field">
      <span>Last name</span>
      <%= text_field_tag :last_name, @names[:last_name], required: true, autocomplete: "family-name" %>
    </label>
    <label class="b270-field">
      <span>Bible translation</span>
      <%= select_tag :bible_version,
            options_for_select(Bible270::Translations.options, current_reader.effective_bible_version),
            class: "b270-select" %>
      <span class="b270-hint" style="margin:0">Reading links open in this translation.</span>
    </label>
    <%= render "bible270/shared/passage_source", reader: current_reader %>

    <% if Bible270.config.daily_reminders? %>
      <% reminder_hour, reminder_minute = @daily_reminder_time.to_s.split(":", 2) %>
      <div class="b270-field">
        <span>Daily reading reminder</span>
        <div class="b270-reminder-row">
          <label class="b270-reminder-optin">
            <%= check_box_tag :daily_reminders, "1", @daily_reminders,
                  aria: { describedby: "daily-reminder-optin-hint" } %>
            <span>Email me each day's readings</span>
            <span class="b270-reminder-tooltip" id="daily-reminder-optin-hint" role="tooltip">
              Uses the plan's configured time zone. You can turn reminders off here at any time.
            </span>
          </label>
          <div class="b270-reminder-time">
            <span>at</span>
            <span class="b270-time-control" role="group" aria-label="Reminder time"
                  aria-describedby="daily-reminder-time-hint">
              <%= select_tag :daily_reminder_hour,
                    options_for_select((0..23).map { |hour| format("%02d", hour) }, reminder_hour),
                    class: "b270-time-select", required: true, aria: { label: "Hour" } %>
              <span class="b270-time-separator" aria-hidden="true">:</span>
              <%= select_tag :daily_reminder_minute,
                    options_for_select((0..59).map { |minute| format("%02d", minute) }, reminder_minute),
                    class: "b270-time-select", required: true, aria: { label: "Minute" } %>
              <span class="b270-reminder-tooltip" id="daily-reminder-time-hint" role="tooltip">
                Uses the plan's configured time zone. You can turn reminders off here at any time.
              </span>
            </span>
          </div>
        </div>
      </div>
    <% end %>

    <%= submit_tag "Save", class: "b270-btn" %>
  <% end %>

  <% if current_reader.avatar_uploaded? %>
    <%= button_to "Remove picture", profile_avatar_path, method: :delete, class: "b270-linkbtn",
          form: { data: { turbo_confirm: "Remove your picture?" } } %>
  <% end %>

  <% unless Bible270::Reader.avatar_uploads? %>
    <p class="b270-hint">Picture uploads need Active Storage in this application
       (<code>bin/rails active_storage:install</code>). Until then, avatars come from your sign-in provider.</p>
  <% end %>
</div>

<p style="margin-top:18px"><%= link_to "← Back to your progress", reader_path(current_reader) %></p>
