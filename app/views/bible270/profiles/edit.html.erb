<% content_for :title, "Profile — #{Bible270.config.app_name}" %>
<% content_for :expand_day_index, "true" %>
<p class="b270-eyebrow">Profile</p>
<h1>Your details</h1>
<p class="lede">This is how you appear beside your reflections and on the community page.</p>

<div class="b270-panel">
  <%= form_with url: profile_path, method: :patch, class: "b270-emailform",
                html: { multipart: true } do %>
    <div class="b270-avatarrow">
      <%= b270_avatar(current_reader, size: 72, loading: 'eager') %>
      <% if Bible270::Reader.avatar_uploads? %>
        <div class="b270-avatarcontrols" style="flex:1;min-width:0">
          <label class="b270-field">
            <span>Picture</span>
            <%= file_field_tag :avatar, accept: Bible270::Avatars.content_types.join(',') %>
            <span class="b270-hint" style="margin:0">
              PNG, JPEG, GIF or WebP, up to <%= Bible270::Avatars.human_size(Bible270::Avatars.max_bytes) %> and <%= Bible270::AvatarOptimizer::MAX_PIXELS / 1_000_000 %> megapixels.
              Automatically center-cropped to a square. Animated pictures use the first frame.
            </span>
          </label>
          <% if current_reader.avatar_uploaded? %>
            <%= button_tag "Remove picture", type: "submit", class: "b270-linkbtn",
                  form: "b270-remove-picture" %>
          <% end %>
        </div>
      <% end %>
    </div>


    <label class="b270-field">
      <span>First name</span>
      <%= text_field_tag :first_name, @names[:first_name], required: true, autocomplete: "given-name" %>
    </label>
    <label class="b270-field">
      <span>Last name</span>
      <%= text_field_tag :last_name, @names[:last_name], required: true, autocomplete: "family-name" %>
    </label>
    <label class="b270-field">
      <span>Bible translation</span>
      <%= select_tag :bible_version,
            options_for_select(Bible270::Translations.options, current_reader.effective_bible_version),
            class: "b270-select" %>
      <span class="b270-hint" style="margin:0">Reading links open in this translation.</span>
    </label>
    <%= render "bible270/shared/passage_source", reader: current_reader %>

    <% if Bible270::Reader.display_mode_column? %>
      <label class="b270-field">
        <span>Theme</span>
        <%= select_tag :display_mode,
              options_for_select(Bible270::Reader::DISPLAY_OPTIONS, @display_mode),
              class: "b270-select", aria: { describedby: "b270-display-hint b270-theme-status" },
              data: { b270_theme_url: profile_theme_path, b270_theme_apply: true,
                      b270_saved_theme: current_reader.effective_display_mode } %>
        <span id="b270-display-hint" class="b270-hint" style="margin:0">System follows your device's setting: Papyrus for light, Cedar for dark.</span>
      </label>
      <p id="b270-theme-status" class="b270-hint" role="status" aria-live="polite" style="margin:0"></p>
    <% else %>
      <p class="b270-flash alert" style="margin:0">
        Theme settings are temporarily unavailable while this installation finishes a database update.
      </p>
    <% end %>

    <% if @comment_notifications_available %>
      <%= render "bible270/shared/comment_notification_choices",
            level: @comment_notification_level,
            personal_label: "Only replies to my reflections and mentions of me" %>
    <% elsif Bible270.config.mention_notifications %>
      <p class="b270-flash alert" style="margin:0">
        Reflection email settings are temporarily unavailable while this installation finishes a database update.
      </p>
    <% end %>

    <% if @daily_reminders_available %>
      <% reminder_local_time = Bible270.local_time(Time.now) %>
      <% reminder_zone = if reminder_local_time.respond_to?(:time_zone)
                           reminder_local_time.time_zone.tzinfo.name
                         else
                           ["Server time zone", reminder_local_time.zone.presence].compact.join(" — ")
                         end %>
      <% reminder_tooltip = "Uses the plan's time zone: #{reminder_zone}, not your device's time zone. You can turn reminders off here at any time." %>
      <% reminder_hour, reminder_minute = @daily_reminder_time.to_s.split(":", 2) %>
      <% reminder_minutes = (Bible270::Reader::DAILY_REMINDER_MINUTES + [reminder_minute]).compact.uniq.sort %>
      <div class="b270-field">
        <span>Daily reading reminder</span>
        <div class="b270-reminder-row">
          <label class="b270-reminder-optin">
            <%= check_box_tag :daily_reminders, "1", @daily_reminders,
                  aria: { describedby: "daily-reminder-optin-hint" } %>
            <span>Email me each day's readings</span>
            <span class="b270-reminder-tooltip" id="daily-reminder-optin-hint" role="tooltip">
              <%= reminder_tooltip %>
            </span>
          </label>
          <div class="b270-reminder-time">
            <span>at</span>
            <span class="b270-time-control" role="group" aria-label="Reminder time"
                  aria-describedby="daily-reminder-time-hint">
              <%= select_tag :daily_reminder_hour,
                    options_for_select((0..23).map { |hour| format("%02d", hour) }, reminder_hour),
                    class: "b270-time-select", required: true, aria: { label: "Hour" } %>
              <span class="b270-time-separator" aria-hidden="true">:</span>
              <%= select_tag :daily_reminder_minute,
                    options_for_select(reminder_minutes, reminder_minute),
                    class: "b270-time-select", required: true, aria: { label: "Minute" } %>
              <span class="b270-reminder-tooltip" id="daily-reminder-time-hint" role="tooltip">
                <%= reminder_tooltip %>
              </span>
            </span>
          </div>
        </div>
        <span id="daily-reminder-zone" class="b270-hint" style="margin:0;overflow-wrap:anywhere">
          Plan time zone: <%= reminder_zone %>
        </span>
      </div>
    <% elsif Bible270.config.daily_reminders? %>
      <p class="b270-flash alert" style="margin:0">
        Daily reminders are temporarily unavailable while this installation finishes a database update.
      </p>
    <% end %>

    <%= submit_tag "Save", class: "b270-btn" %>
  <% end %>

  <% if current_reader.avatar_uploaded? %>
    <%# The picture button targets this separate form so it never submits profile edits. %>
    <%= form_with url: profile_avatar_path, method: :delete,
          html: { id: "b270-remove-picture", hidden: true },
          data: { turbo_confirm: "Remove your picture?" } do %>
    <% end %>
  <% end %>

  <% unless Bible270::Reader.avatar_uploads? %>
    <p class="b270-hint">Picture uploads need Active Storage in this application
       (<code>bin/rails active_storage:install</code>). Until then, avatars come from your sign-in provider.</p>
  <% end %>
</div>

<p style="margin-top:18px"><%= link_to "← Back to your progress", progress_path %></p>
