<%# locals: (day:, reader:) %>
<%
  previous_day = day > 1 ? day - 1 : nil
  next_day = day < Bible270::Plan::DAYS ? day + 1 : nil
  total_parts = Bible270::Plan.total_parts(day)
  complete = reader&.day_complete?(day)
%>
<div id="day_progress_<%= day %>">
  <div class="b270-daynav">
    <% if previous_day %>
      <%= link_to "‹", day_path(previous_day), class: "b270-arrow", "aria-label": "Previous day" %>
    <% else %>
      <%= button_tag "‹", type: "button", class: "b270-arrow disabled", disabled: true,
            "aria-label": "Previous day unavailable" %>
    <% end %>
    <div class="b270-dayhead">
      <div class="k">Day <%= day %><% if complete %><span class="b270-badge" data-b270-compact-hide>Complete</span><% end %></div>
      <% if reader&.dated? %>
        <div class="date">
          <%= reader.date_for_day(day).strftime("%A, %B %-d, %Y") %>
          <% if reader.today?(day) %><span class="b270-badge" data-b270-compact-hide>Today</span><% end %>
        </div>
      <% end %>
    </div>
    <% if next_day %>
      <%= link_to "›", day_path(next_day), class: "b270-arrow", "aria-label": "Next day" %>
    <% else %>
      <%= button_tag "›", type: "button", class: "b270-arrow disabled", disabled: true,
            "aria-label": "Next day unavailable" %>
    <% end %>
  </div>


  <% if complete %>
    <div class="b270-day-complete" role="status" aria-live="polite">
      <div data-b270-compact-hide>
        <strong>Day <%= day %> complete</strong>
        <span>All <%= total_parts %> portions are checked off.</span>
      </div>
      <% if next_day %>
        <%= link_to "Continue to Day #{next_day} →", day_path(next_day), class: "b270-btn" %>
      <% else %>
        <%= link_to "View My Progress →", progress_path, class: "b270-btn" %>
      <% end %>
    </div>
  <% end %>
</div>
