<%# locals: (day:, completers:) %>
<div class="b270-completers" id="completers_<%= day %>">
  <% if completers.any? %>
    <span>Finished this day:</span>
    <% completers.each do |reader| %>
      <%= link_to b270_avatar(reader, size: 56), reader_path(reader), title: reader.display_name %>
    <% end %>
  <% end %>
</div>
