<% content_for :title, 'Scripture frames — Admin' %>
<div class="b270-admin-view-header">
  <p class="b270-eyebrow"><%= link_to 'Admin', admin_path %></p>
  <% if @storage_available %>
    <%= link_to 'Add text', new_admin_scripture_frame_path, class: 'b270-btn' %>
  <% end %>
</div>
<h1>Scripture frames</h1>
<p class="lede">Custom texts supplement the bundled defaults</p>
<p class="b270-hint">Hover or focus a heading to read the passage; select it to expand the text.</p>

<section class="b270-panel" id="b270-custom-scripture-texts" aria-labelledby="b270-custom-scripture-heading">
  <h2 class="b270-subhead" id="b270-custom-scripture-heading">Custom texts</h2>
  <% if @storage_available %>
    <% if @scripture_frames.empty? %><p>No custom texts yet.</p><% end %>
    <% @scripture_frames.each do |frame| %>
      <section class="b270-scripture-library-entry" aria-label="Custom text: <%= frame.reference %>">
        <%= render 'bible270/admin/scripture_text', frame: frame, source: 'Custom', text_id: "b270-scripture-manage-custom-#{frame.id}" %>
        <div class="b270-scripture-actions">
          <%= link_to 'Edit', edit_admin_scripture_frame_path(frame), aria: { label: "Edit #{frame.reference}" } %>
          <%= button_to frame.enabled? ? 'Disable' : 'Enable', admin_scripture_frame_path(frame), method: :patch,
                params: { scripture_frame: { enabled: frame.enabled? ? '0' : '1' } }, class: 'b270-linkbtn',
                aria: { label: "#{frame.enabled? ? 'Disable' : 'Enable'} #{frame.reference}" } %>
          <%= button_to 'Delete', admin_scripture_frame_path(frame), method: :delete, class: 'b270-linkbtn',
                aria: { label: "Delete #{frame.reference}" },
                form: { data: { b270_admin_confirm: 'Delete this custom scripture frame permanently?' } } %>
        </div>
      </section>
    <% end %>
  <% else %>
    <p class="b270-hint" role="status">Custom scripture frames are unavailable until database migrations are run. Bundled texts remain available.</p>
  <% end %>
</section>

<section class="b270-panel" id="b270-default-scripture-texts" aria-labelledby="b270-default-scripture-heading">
  <h2 class="b270-subhead" id="b270-default-scripture-heading">Default texts</h2>
  <p class="b270-hint">Defaults are read-only.</p>
  <% @defaults.each_with_index do |frame, index| %>
    <section class="b270-scripture-library-entry" aria-label="Bundled text: <%= frame.reference %>">
      <%= render 'bible270/admin/scripture_text', frame: frame, source: 'Default', text_id: "b270-scripture-manage-default-#{index}" %>
    </section>
  <% end %>
</section>

<%= render 'bible270/shared/admin_confirmations' %>
