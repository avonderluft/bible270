<% content_for :title, "My Progress — #{Bible270.config.app_name}" %>

<p class="b270-eyebrow">My Progress</p>
<h1>Your reading journey</h1>

<%= render "bible270/shared/progress", show_start_date: false %>

<% if @reader %>
  <%= render "bible270/readers/next_steps", partial_day_tasks: @partial_day_tasks,
        remaining_partial_days: @remaining_partial_days %>
<% end %>

<div class="b270-panel">
  <%= render "bible270/shared/reflections", comments: @recent_comments,
        title: "Your recent reflections",
        empty_text: "You have not written any reflections yet." %>
</div>
