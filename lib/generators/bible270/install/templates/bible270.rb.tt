# frozen_string_literal: true
#
# bible270 configuration. See the gem README for the full reference.
Bible270.configure do |config|
  # --- Where the plan lives --------------------------------------------------
  # Change this one value to move the plan; config/routes.rb and
  # config/initializers/omniauth.rb both read it, so nothing else needs editing.
  # (Remember to update the callback URLs registered with each OAuth provider.)
  config.mount_at = "<%= mount_at %>"

  config.app_name = "Daily Bread"
  config.tagline  = "Journeying through Scripture in 9 months"

  # Share the host application's layout, helpers and CSRF setup.
  config.parent_controller = "::ApplicationController"
  # config.layout = "layouts/application"

  # --- Authentication --------------------------------------------------------
  # Email sign-in: a one-time link, no password, no third-party account needed.
  # This is what lets anyone take part. Requires Action Mailer delivery to work.
  config.email_sign_in = true
  config.mailer_from   = "no-reply@example.com"     # <- change me
  # config.email_sign_in_ttl = 20 * 60              # link lifetime, seconds
  # config.email_sign_in_max_per_window = 5         # per email, per window
  # config.email_sign_in_window = 15 * 60
  config.email_sign_in_ask_name = true              # let readers choose a display name
  # config.email_sign_in_deliver_later = true       # if you have a queue backend

  # Optional social sign-in. The matching strategy gems and credentials live in
  # the host app (see config/initializers/omniauth.rb). Set to [] to use email only.
  config.omniauth_providers = [<%= providers_literal %>]

  # Viewing the plan is always public; checking off and commenting require a reader.
  config.require_sign_in_to_participate = true

  # Where to land after signing in / out (defaults to the plan's own root).
  # config.after_sign_in_path  = "<%= mount_at %>"
  # config.after_sign_out_path = "/"

  # --- Admin ----------------------------------------------------------------
  # config.admin_emails = %w[andrew@example.org]
  # or
  # config.admin_resolver = ->(reader) { reader.email.to_s.end_with?('@example.org') }
  #
  # --- Notify admin of new user sign-ins -------------------------------------
  # Who to email when someone new joins. :admins follows admin_emails, or give an
  # explicit list. Leave empty for no notices.
  # config.registration_notice_emails = :admins              # everyone in admin_emails
  # config.registration_notice_emails = %w[admin@example.com]  # or an explicit list
  # config.mailer_host = 'example.com'                          # lets the notice link to the reader
  # config.registration_notice_deliver_later = true          # needs Active Job

  # --- Start date ------------------------------------------------------------
  # Community-wide start date (Date, Time, or "YYYY-MM-DD"), or nil for undated.
  # config.start_date = Date.new(2026, 9, 6)
  # Allow personal calendars, stamped when an undated reader first checks off.
  config.allow_reader_start_date = true

  # --- Daily reading reminders -----------------------------------------------
  # Readers choose an opt-in time on their profile only when this is enabled.
  # The host app owns scheduling: run `bin/rails bible270:reminders:send` every 15 minutes.
  config.daily_reminders = false
  config.mention_notifications = true # direct replies and @mentions; readers may opt out
  # config.mailer_host = "example.com"       # required for day/profile links in email

  # --- Reading links ---------------------------------------------------------
  config.bible_version = "NKJV"

  # --- Custom chapter breaks -------------------------------------------------
  # config.chapter_breaks = { 'Psalm 78' => [20, 39, 55] }
  #
  # or YAML file:
  # config.chapter_breaks_path = Rails.root.join('config/bible270_breaks.yml')
  # config/bible270_breaks.yml — re-read whenever it changes
  # Psalm 35: []
  # Psalm 78: [20, 39, 55]

  # --- Custom footer options -------------------------------------------------
  # The engine's pages end with a short note about how the plan works. Replace it with your own
  # - a partial in your app at /app/views/layouts/_bible270_footer.html.erb
  # config.footer_partial = 'layouts/bible270_footer'  
  # config.footer_html    = '<p>&copy; 2026 …</p>'
  # config.footer         = false                # no footer at all
  #
  # config.footer_placement = :after    # engine's note, then yours
  # config.footer_placement = :before   # yours, then the engine's note
  # config.footer_placement = :replace  # default
end
